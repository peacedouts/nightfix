// Deploy config used when Workers Builds runs from the repository root.
//
// PRE-LAUNCH: this serves the teaser (teaser/public) so a build from the repo
// root can never publish the full site or docs. The full site's own config is
// website/wrangler.jsonc (root directory "website").
//
// AT LAUNCH: restore the build below and point assets back at ./website/dist.
//   "build": { "command": "npm ci && npm run build", "cwd": "website" },
//   "assets": { "directory": "./website/dist", "not_found_handling": "404-page" }
{
  "name": "nightfix",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./teaser/public",
    "not_found_handling": "404-page"
  }
}
