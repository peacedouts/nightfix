// Deploy config for the website as a Cloudflare Worker (static assets only).
// Used when Workers Builds runs from the repository root; website/wrangler.jsonc
// is used when the root directory is set to "website". Both deploy the same site.
{
  "$schema": "website/node_modules/wrangler/config-schema.json",
  "name": "nightfix",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm ci && npm run build",
    "cwd": "website"
  },
  "assets": {
    "directory": "./website/dist",
    "not_found_handling": "404-page"
  }
}
