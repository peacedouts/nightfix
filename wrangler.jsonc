// Deploy config used when Workers Builds runs from the repository root.
//
// PRE-LAUNCH: the only public site is the teaser in teaser/public. The full
// marketing site and docs were removed from main and are kept on the branch
// `archive/full-site`. To bring them back at launch:
//   git checkout origin/archive/full-site -- website
// then restore this config to build it:
//   "build": { "command": "npm ci && npm run build", "cwd": "website" },
//   "assets": { "directory": "./website/dist", "not_found_handling": "404-page" }
{
  "name": "nightfix",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./teaser/public",
    "not_found_handling": "404-page"
  }
}
